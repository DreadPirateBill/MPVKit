 }
 
-void ra_cvpixel_submit_frame(struct ra_ctx *ctx, const mpv_cvpixel_timing *timing)
+void ra_cvpixel_submit_frame(struct ra_ctx *ctx, int64_t due_at_ns, double duration_ns)
 {
     struct priv *p = ctx->priv;
     if (!p->pbuf)
@@ -290,7 +291,14 @@ void ra_cvpixel_submit_frame(struct ra_ctx *ctx, const mpv_cvpixel_timing *timin
     CFRelease(p->mtltex);
