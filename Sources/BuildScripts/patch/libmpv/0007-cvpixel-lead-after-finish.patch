diff --git forkSrcPrefix/video/out/vulkan/context_cvpixel.h forkDstPrefix/video/out/vulkan/context_cvpixel.h
index d592415..ba5d03d 100644
--- forkSrcPrefix/video/out/vulkan/context_cvpixel.h
+++ forkDstPrefix/video/out/vulkan/context_cvpixel.h
@@ -19,7 +19,10 @@ bool ra_cvpixel_start_frame(struct ra_ctx *ctx, const struct pl_color_space *csp
 // Wait for the GPU, hand the buffer to the sink with when it is due, release
 // the wrapper. Called from draw_frame, before vo.c's wait for the target time,
 // so the client has the frame ahead of its due moment.
-void ra_cvpixel_submit_frame(struct ra_ctx *ctx, const mpv_cvpixel_timing *timing);
+// due_at_ns: when the frame is due on mp_time (0 = as soon as possible, a redraw);
+// duration_ns: its nominal display duration (< 0 unknown). The lead handed to the
+// sink is measured inside, after the GPU finish, so it is current at the call.
+void ra_cvpixel_submit_frame(struct ra_ctx *ctx, int64_t due_at_ns, double duration_ns);
 
 // Drop an unsubmitted frame and tell the sink to flush.
 void ra_cvpixel_flush(struct ra_ctx *ctx);
