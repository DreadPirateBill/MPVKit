diff --git forkSrcPrefix/options/options.h forkDstPrefix/options/options.h
--- forkSrcPrefix/options/options.h
+++ forkDstPrefix/options/options.h
@@ -86,6 +86,8 @@
     int video_sync;
 
     struct m_geometry android_surface_size;
+
+    struct m_geometry moltenvk_surface_size;
 
     struct m_geometry d3d11_composition_size;
 
diff --git forkSrcPrefix/player/command.c forkDstPrefix/player/command.c
--- forkSrcPrefix/player/command.c
+++ forkDstPrefix/player/command.c
@@ -8017,7 +8017,8 @@
             queue_seek(mpctx, MPSEEK_RELATIVE, 0.0, MPSEEK_EXACT, 0);
     }
 
-    if (opt_ptr == &opts->vo->android_surface_size || opt_ptr == &opts->vo->d3d11_composition_size) {
+    if (opt_ptr == &opts->vo->android_surface_size || opt_ptr == &opts->vo->d3d11_composition_size ||
