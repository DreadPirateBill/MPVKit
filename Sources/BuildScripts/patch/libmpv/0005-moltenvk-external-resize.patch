diff --git forkSrcPrefix/video/out/vulkan/context_moltenvk.m forkDstPrefix/video/out/vulkan/context_moltenvk.m
--- forkSrcPrefix/video/out/vulkan/context_moltenvk.m
+++ forkDstPrefix/video/out/vulkan/context_moltenvk.m
@@ -22,6 +22,7 @@
 #include "common.h"
 #include "context.h"
 #include "utils.h"
+#include "options/options.h"
 
 struct priv {
     struct mpvk_ctx vk;
@@ -76,8 +77,20 @@
 static bool moltenvk_reconfig(struct ra_ctx *ctx)
 {
     struct priv *p = ctx->priv;
+    // The layer belongs to the client, and nothing here hears about its layout:
+    // a rotated or resized layer kept the swapchain, and the picture, at the
+    // size of the first configure. The client reports the layer's new size in
+    // pixels through --moltenvk-surface-size, which arrives as
+    // VOCTRL_EXTERNAL_RESIZE and lands here (as --android-surface-size does
+    // for the Android contexts). Until it has, the layer's own drawable size.
     CGSize s = p->layer.drawableSize;
-    ra_vk_ctx_resize(ctx, s.width, s.height);
+    int w = ctx->vo->opts->moltenvk_surface_size.w;
+    int h = ctx->vo->opts->moltenvk_surface_size.h;
+    if (w <= 0)
+        w = s.width;
+    if (h <= 0)
+        h = s.height;
+    ra_vk_ctx_resize(ctx, w, h);
     return true;
 }
 
