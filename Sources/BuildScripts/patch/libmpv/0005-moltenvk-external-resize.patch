diff --git forkSrcPrefix/options/options.c forkDstPrefix/options/options.c
--- forkSrcPrefix/options/options.c
+++ forkDstPrefix/options/options.c
@@ -246,6 +246,9 @@
 #if HAVE_EGL_ANDROID
     {"android-surface-size", OPT_SIZE_BOX(android_surface_size)},
 #endif
+#if HAVE_MOLTENVK
