+ * GNU Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with mpv.  If not, see <http://www.gnu.org/licenses/>.
+ */
+
+// The "cvpixel" gpu-context: headless MoltenVK whose render target is a Metal
+// texture imported from a client-supplied CVPixelBuffer. gpu-next renders into
+// it exactly as it would into a swapchain image (scaling, debanding, tone
+// mapping, Dolby Vision reshaping, OSD), and the finished buffer goes back to
+// the client for AVFoundation to display. Companion to context_moltenvk.m,
+// which presents to a CAMetalLayer instead.
+
+#include <CoreVideo/CoreVideo.h>
+#include <Metal/Metal.h>
+#include <MoltenVK/mvk_vulkan.h>
+#include <libplacebo/vulkan.h>
+
+#include "mpv/cvpixel.h"
+#include "common.h"
+#include "context.h"
+#include "context_cvpixel.h"
+#include "utils.h"
+
+struct priv {
+    struct mpvk_ctx vk;
+    mpv_cvpixel_sink *sink;
+    CVMetalTextureCacheRef cache;
+    pl_fmt fmt;
+
+    // The frame between start_frame and submit_frame
+    CVPixelBufferRef pbuf;
+    CVMetalTextureRef mtltex;
+    pl_tex tex;
+    struct pl_color_space csp;
+};
+
+// The Metal device MoltenVK is using, so the texture cache creates textures on
+// the same device libplacebo renders with (same approach as hwdec_vt_pl.m).
+static id<MTLDevice> mtl_device_for(pl_vulkan vulkan)
+{
+    id<MTLDevice> dev = nil;
+#ifdef VK_EXT_METAL_OBJECTS_SPEC_VERSION
+    if (vulkan && vulkan->device && vulkan->instance && vulkan->get_proc_addr) {
+        PFN_vkExportMetalObjectsEXT export_fn = (PFN_vkExportMetalObjectsEXT)
+            vulkan->get_proc_addr(vulkan->instance, "vkExportMetalObjectsEXT");
+        if (export_fn) {
+            VkExportMetalDeviceInfoEXT dev_info = {
+                .sType = VK_STRUCTURE_TYPE_EXPORT_METAL_DEVICE_INFO_EXT,
+            };
+            VkExportMetalObjectsInfoEXT info = {
+                .sType = VK_STRUCTURE_TYPE_EXPORT_METAL_OBJECTS_INFO_EXT,
+                .pNext = &dev_info,
+            };
+            export_fn(vulkan->device, &info);
+            dev = dev_info.mtlDevice;
+            [dev retain];
+        }
+    }
+#endif
+    if (!dev)
+        dev = MTLCreateSystemDefaultDevice();
+    return dev;
+}
+
+static void drop_frame(struct priv *p)
+{
+    if (p->tex)
+        pl_tex_destroy(p->vk.gpu, &p->tex);
+    if (p->mtltex) {
+        CFRelease(p->mtltex);
+        p->mtltex = NULL;
+    }
+    if (p->pbuf) {
+        CVPixelBufferRelease(p->pbuf);
+        p->pbuf = NULL;
+    }
+}
+
+static void cvpixel_uninit(struct ra_ctx *ctx)
+{
+    struct priv *p = ctx->priv;
+    if (!p)
+        return;
+    drop_frame(p);
+    if (p->cache) {
+        CFRelease(p->cache);
+        p->cache = NULL;
+    }
+    ra_vk_ctx_uninit(ctx);
+    mpvk_uninit(&p->vk);
+}
+
+static bool cvpixel_init(struct ra_ctx *ctx)
+{
+    struct priv *p = ctx->priv = talloc_zero(ctx, struct priv);
+    struct mpvk_ctx *vk = &p->vk;
+    int msgl = ctx->opts.probing ? MSGL_V : MSGL_ERR;
+
+    p->sink = (mpv_cvpixel_sink *)(intptr_t)ctx->vo->opts->cvpixel_sink;
+    if (!p->sink || !p->sink->acquire || !p->sink->present) {
+        MP_MSG(ctx, msgl, "cvpixel-sink missing or incomplete\n");
+        goto fail;
+    }
+
+    // The Metal surface extension is harmless without a surface; requesting
+    // it keeps instance creation identical to the moltenvk context.
+    if (!mpvk_init(vk, ctx, VK_EXT_METAL_SURFACE_EXTENSION_NAME))
+        goto fail;
+
+    struct ra_ctx_params params = {0};
+    if (!ra_vk_ctx_init_headless(ctx, vk, params))
+        goto fail;
+
+    p->fmt = pl_find_fmt(vk->gpu, PL_FMT_FLOAT, 4, 16, 16,
+                         PL_FMT_CAP_RENDERABLE | PL_FMT_CAP_BLITTABLE);
+    if (!p->fmt) {
+        MP_MSG(ctx, msgl, "No renderable RGBA16F format\n");
+        goto fail;
+    }
+
+    id<MTLDevice> dev = mtl_device_for(vk->vulkan);
+    CVReturn err = CVMetalTextureCacheCreate(kCFAllocatorDefault, NULL, dev, NULL, &p->cache);
+    [dev release];
+    if (err != noErr) {
+        MP_MSG(ctx, msgl, "CVMetalTextureCacheCreate failed: %d\n", (int)err);
+        goto fail;
+    }
+
+    return true;
+
+fail:
+    cvpixel_uninit(ctx);
+    return false;
+}
+
+static bool cvpixel_reconfig(struct ra_ctx *ctx)
+{
+    struct priv *p = ctx->priv;
+    int w = 0, h = 0;
+    if (p->sink->size)
+        p->sink->size(p->sink->user_data, &w, &h);
+    if (w <= 0 || h <= 0) {
+        w = 1920;
+        h = 1080;
+    }
+    return ra_vk_ctx_resize(ctx, w, h);
+}
+
+static int cvpixel_control(struct ra_ctx *ctx, int *events, int request, void *arg)
+{
+    return VO_NOTIMPL;
+}
+
+const struct ra_ctx_fns ra_ctx_vulkan_cvpixel = {
+    .type           = "vulkan",
+    .name           = "cvpixel",
+    .reconfig       = cvpixel_reconfig,
+    .control        = cvpixel_control,
+    .init           = cvpixel_init,
+    .uninit         = cvpixel_uninit,
+};
+
+bool ra_cvpixel_ctx_is(struct ra_ctx *ctx)
+{
+    return ctx && ctx->fns == &ra_ctx_vulkan_cvpixel;
+}
+
+bool ra_cvpixel_start_frame(struct ra_ctx *ctx, const struct pl_color_space *csp,
+                            struct pl_swapchain_frame *out_frame)
+{
+    struct priv *p = ctx->priv;
+    pl_gpu gpu = p->vk.gpu;
+
+    drop_frame(p);   // a frame that was started but never submitted
+
+    int w = ctx->vo->dwidth, h = ctx->vo->dheight;
+    if (w <= 0 || h <= 0)
+        return false;
+
+    CVPixelBufferRef buf = p->sink->acquire(p->sink->user_data, w, h,
+                                            kCVPixelFormatType_64RGBAHalf);
+    if (!buf)
+        return false;
+
+    size_t bw = CVPixelBufferGetWidth(buf), bh = CVPixelBufferGetHeight(buf);
+    CVMetalTextureRef mtltex = NULL;
+    CVReturn err = CVMetalTextureCacheCreateTextureFromImage(
+        kCFAllocatorDefault, p->cache, buf, NULL, MTLPixelFormatRGBA16Float,
+        bw, bh, 0, &mtltex);
+    if (err != noErr || !mtltex) {
+        MP_ERR(ctx, "CVMetalTextureCacheCreateTextureFromImage failed: %d\n", (int)err);
+        CVPixelBufferRelease(buf);
+        return false;
+    }
+
+    pl_tex tex = pl_tex_create(gpu, &(struct pl_tex_params) {
+        .w = bw,
+        .h = bh,
+        .format = p->fmt,
+        .renderable = true,
+        .blit_dst = true,
+        .import_handle = PL_HANDLE_MTL_TEX,
+        .shared_mem = (struct pl_shared_mem) {
+            .handle = { .handle = CVMetalTextureGetTexture(mtltex) },
+        },
+    });
+    if (!tex) {
+        MP_ERR(ctx, "Failed importing the CVPixelBuffer's Metal texture\n");
+        CFRelease(mtltex);
+        CVPixelBufferRelease(buf);
+        return false;
+    }
+
+    p->pbuf = buf;
+    p->mtltex = mtltex;
+    p->tex = tex;
+    p->csp = *csp;
+
+    *out_frame = (struct pl_swapchain_frame) {
+        .fbo = tex,
+        .flipped = false,
+        .color_repr = {
+            .sys = PL_COLOR_SYSTEM_RGB,
+            .levels = PL_COLOR_LEVELS_FULL,
+            .alpha = PL_ALPHA_UNKNOWN,
+            .bits = { .sample_depth = 16, .color_depth = 16 },
+        },
+        .color_space = *csp,
+    };
+    return true;
+}
+
+static void fill_color(mpv_cvpixel_color *out, const struct pl_color_space *csp)
+{
+    *out = (mpv_cvpixel_color) {0};
+    switch (csp->primaries) {
+    case PL_COLOR_PRIM_BT_709:    out->primaries = MPV_CVPIXEL_PRIM_BT709;  break;
+    case PL_COLOR_PRIM_BT_2020:   out->primaries = MPV_CVPIXEL_PRIM_BT2020; break;
+    case PL_COLOR_PRIM_DCI_P3:
+    case PL_COLOR_PRIM_DISPLAY_P3: out->primaries = MPV_CVPIXEL_PRIM_P3;    break;
+    default:                      out->primaries = MPV_CVPIXEL_PRIM_UNKNOWN; break;
+    }
+    switch (csp->transfer) {
+    case PL_COLOR_TRC_PQ:   out->transfer = MPV_CVPIXEL_TRC_PQ;   break;
+    case PL_COLOR_TRC_HLG:  out->transfer = MPV_CVPIXEL_TRC_HLG;  break;
+    case PL_COLOR_TRC_SRGB: out->transfer = MPV_CVPIXEL_TRC_SRGB; break;
+    default:                out->transfer = MPV_CVPIXEL_TRC_UNKNOWN; break;
+    }
+    out->min_luma = csp->hdr.min_luma;
+    out->max_luma = csp->hdr.max_luma;
+    out->max_cll  = csp->hdr.max_cll;
+    out->max_fall = csp->hdr.max_fall;
+    out->red[0]   = csp->hdr.prim.red.x;   out->red[1]   = csp->hdr.prim.red.y;
+    out->green[0] = csp->hdr.prim.green.x; out->green[1] = csp->hdr.prim.green.y;
+    out->blue[0]  = csp->hdr.prim.blue.x;  out->blue[1]  = csp->hdr.prim.blue.y;
+    out->white[0] = csp->hdr.prim.white.x; out->white[1] = csp->hdr.prim.white.y;
+}
+
+void ra_cvpixel_submit_frame(struct ra_ctx *ctx)
+{
+    struct priv *p = ctx->priv;
+    if (!p->pbuf)
+        return;
+
+    // Rendering into an imported Metal texture: make sure the GPU is done
+    // before AVFoundation samples it. A shared event would avoid the stall;
+    // first version keeps it simple.
+    pl_gpu_finish(p->vk.gpu);
+
+    mpv_cvpixel_color color;
+    fill_color(&color, &p->csp);
+
+    CVPixelBufferRef buf = p->pbuf;   // the +1 from acquire passes to the sink
+    p->pbuf = NULL;
+    pl_tex_destroy(p->vk.gpu, &p->tex);
+    CFRelease(p->mtltex);
+    p->mtltex = NULL;
+
+    p->sink->present(p->sink->user_data, buf, &color);
+    CVMetalTextureCacheFlush(p->cache, 0);
+}
+
+void ra_cvpixel_flush(struct ra_ctx *ctx)
+{
+    struct priv *p = ctx->priv;
+    drop_frame(p);
+    if (p->sink->flush)
+        p->sink->flush(p->sink->user_data);
+}
