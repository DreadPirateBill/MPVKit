 }
 
+// A context without a swapchain: gpu-next supplies its own render target
+// (see context_cvpixel.m). Only the ra_swapchain plumbing that vo_gpu_next
+// touches is stubbed; the ra (vo_gpu) path is unsupported and start_frame
+// refuses it.
+static bool headless_start_frame(struct ra_swapchain *sw, struct ra_fbo *out_fbo)
+{
+    return out_fbo == NULL;
+}
+
+static bool headless_submit_frame(struct ra_swapchain *sw, const struct vo_frame *frame)
+{
+    return true;
+}
+
+static void headless_swap_buffers(struct ra_swapchain *sw)
+{
+}
+
+static int headless_color_depth(struct ra_swapchain *sw)
+{
+    return 16;
+}
+
+static const struct ra_swapchain_fns headless_swapchain = {
+    .color_depth   = headless_color_depth,
+    .start_frame   = headless_start_frame,
+    .submit_frame  = headless_submit_frame,
+    .swap_buffers  = headless_swap_buffers,
+};
+
+bool ra_vk_ctx_init_headless(struct ra_ctx *ctx, struct mpvk_ctx *vk,
+                             struct ra_ctx_params params)
+{
+    struct ra_swapchain *sw = ctx->swapchain = talloc_zero(NULL, struct ra_swapchain);
+    sw->ctx = ctx;
+    sw->fns = &headless_swapchain;
+
+    struct priv *p = sw->priv = talloc_zero(sw, struct priv);
+    p->vk = vk;
+    p->params = params;
+    p->opts = mp_get_config_group(p, ctx->global, &vulkan_conf);
+
+    vk->vulkan = mppl_create_vulkan(p->opts, vk->vkinst, vk->pllog, VK_NULL_HANDLE,
+                                    ctx->opts.allow_sw);
+    if (!vk->vulkan)
+        goto error;
+
+    vk->gpu = vk->vulkan->gpu;
+    ctx->ra = ra_create_pl(vk->gpu, ctx->log);
+    if (!ctx->ra)
+        goto error;
+
+    vk->swapchain = NULL;
+    return true;
+
+error:
+    ra_vk_ctx_uninit(ctx);
+    return false;
+}
