+#ifndef MPV_CLIENT_API_CVPIXEL_H_
+#define MPV_CLIENT_API_CVPIXEL_H_
+
+/*
+ * The CVPixelBuffer sink: an alternative video output for Apple platforms in
+ * which mpv (gpu-next + libplacebo) renders every finished frame into a
+ * CVPixelBuffer the client supplies, instead of presenting to a CAMetalLayer.
+ * The client then hands the buffer to AVFoundation (AVSampleBufferDisplayLayer),
+ * the only path on tvOS that can drive an HDR display. libplacebo's scaling,
+ * debanding, tone/gamut mapping and Dolby Vision reshaping all still apply.
+ *
+ * Usage:
+ *   - set "vo" to "gpu-next", "gpu-api" to "vulkan", "gpu-context" to "cvpixel"
+ *   - set the option "cvpixel-sink" (MPV_FORMAT_INT64) to the address of a
+ *     mpv_cvpixel_sink that outlives the mpv core
+ *   - set "target-colorspace-hint" to "yes" to receive HDR frames encoded in
+ *     the source's colour space (PQ / HLG, BT.2020); leave it "no" for SDR
+ *     BT.709 frames with libplacebo tone-mapping
+ *
+ * All callbacks are invoked on mpv's VO thread and must not call back into
+ * libmpv. Buffers are IOSurface-backed kCVPixelFormatType_64RGBAHalf, full
+ * range RGB, encoded per `mpv_cvpixel_color`.
+ */
+
+#include <stdint.h>
+#include <CoreVideo/CoreVideo.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef enum mpv_cvpixel_primaries {
+    MPV_CVPIXEL_PRIM_UNKNOWN = 0,
+    MPV_CVPIXEL_PRIM_BT709   = 1,
+    MPV_CVPIXEL_PRIM_BT2020  = 2,
+    MPV_CVPIXEL_PRIM_P3      = 3,
+} mpv_cvpixel_primaries;
+
+typedef enum mpv_cvpixel_transfer {
+    MPV_CVPIXEL_TRC_UNKNOWN = 0,   // SDR, BT.1886 / gamma 2.2
+    MPV_CVPIXEL_TRC_SRGB    = 1,
+    MPV_CVPIXEL_TRC_PQ      = 2,
+    MPV_CVPIXEL_TRC_HLG     = 3,
+} mpv_cvpixel_transfer;
+
+/**
+ * How the pixels of a presented buffer are encoded, plus the static HDR
+ * metadata mpv rendered against (all in cd/m²; 0 when unknown). The client
+ * attaches these to the buffer for the display pipeline.
+ */
+typedef struct mpv_cvpixel_color {
+    int primaries;      // mpv_cvpixel_primaries
+    int transfer;       // mpv_cvpixel_transfer
+    float min_luma;     // mastering display minimum luminance
+    float max_luma;     // mastering display maximum luminance
+    float max_cll;      // maximum content light level
+    float max_fall;     // maximum frame-average light level
+    float red[2];       // mastering display primaries, CIE 1931 xy (0 when unknown)
+    float green[2];
+    float blue[2];
+    float white[2];
+} mpv_cvpixel_color;
+
+/**
+ * The client's side of the sink. Every field except `flush` and `size` is
+ * required.
+ */
+typedef struct mpv_cvpixel_sink {
+    void *user_data;
+
+    /**
+     * The output size in pixels mpv should render at. Called on reconfigure.
+     * Optional: when NULL (or when it yields a non-positive size) mpv renders
+     * at 1920x1080.
+     */
+    void (*size)(void *user_data, int *width, int *height);
+
+    /**
+     * Provide a buffer for one frame: exactly width x height, IOSurface-backed,
+     * of the given pixel format (currently always kCVPixelFormatType_64RGBAHalf).
+     * Return it with a +1 retain; mpv releases its reference after `present`.
+     * Returning NULL skips the frame.
+     */
+    CVPixelBufferRef (*acquire)(void *user_data, int width, int height,
+                                uint32_t pixel_format);
+
+    /**
+     * The frame has been rendered and the GPU work has completed. Ownership of
+     * `buffer` (the +1 from acquire) passes to the client, which must release
+     * it when done. `color` describes the encoding.
+     */
+    void (*present)(void *user_data, CVPixelBufferRef buffer,
+                    const mpv_cvpixel_color *color);
+
+    /**
+     * Playback was reset (seek, new file, stop): drop any frames the client
+     * still holds queued for display. Optional.
+     */
+    void (*flush)(void *user_data);
+} mpv_cvpixel_sink;
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif
