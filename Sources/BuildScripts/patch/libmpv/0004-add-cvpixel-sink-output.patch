diff --git forkSrcPrefix/video/out/vulkan/context_cvpixel.h forkDstPrefix/video/out/vulkan/context_cvpixel.h
new file mode 100644
index 0000000..8d531d6
--- /dev/null
+++ forkDstPrefix/video/out/vulkan/context_cvpixel.h
@@ -0,0 +1,22 @@
+#pragma once
+
+#include <libplacebo/renderer.h>
+#include "video/out/gpu/context.h"
+
+// The "cvpixel" gpu-context (Apple only): headless Vulkan (MoltenVK) whose
+// render target is a Metal texture imported from a client-supplied
+// CVPixelBuffer. See include/mpv/cvpixel.h for the client side.
+
+// Whether `ctx` is a cvpixel context.
+bool ra_cvpixel_ctx_is(struct ra_ctx *ctx);
+
+// Acquire a buffer from the sink and wrap it as a render target encoded in
+// `csp`. On success fills `out_frame` (single RGBA16F plane, full-range RGB).
+bool ra_cvpixel_start_frame(struct ra_ctx *ctx, const struct pl_color_space *csp,
+                            struct pl_swapchain_frame *out_frame);
+
+// Wait for the GPU, hand the buffer to the sink, release the wrapper.
+void ra_cvpixel_submit_frame(struct ra_ctx *ctx);
+
+// Drop an unsubmitted frame and tell the sink to flush.
+void ra_cvpixel_flush(struct ra_ctx *ctx);
diff --git forkSrcPrefix/video/out/vulkan/context_cvpixel.m forkDstPrefix/video/out/vulkan/context_cvpixel.m
new file mode 100644
index 0000000..a7c0e18
--- /dev/null
+++ forkDstPrefix/video/out/vulkan/context_cvpixel.m
@@ -0,0 +1,301 @@
