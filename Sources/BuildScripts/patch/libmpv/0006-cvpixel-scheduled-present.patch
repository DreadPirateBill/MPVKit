+/**
+ * When a presented buffer is due on the display. mpv's playloop hands the
+ * output each frame ahead of its target time (--video-timing-offset, 50 ms by
+ * default) and the frame is rendered at once, so the buffer reaches the client
+ * before it is due: the client schedules it for that moment (an
+ * AVSampleBufferDisplayLayer presents a buffer at its timestamp, on the
+ * display's own refresh) instead of showing it as soon as it arrives, which
+ * would land it on whichever refresh follows the render.
+ */
+typedef struct mpv_cvpixel_timing {
+    int64_t due_in_ns;   // nanoseconds from the moment of the call until the frame is due; <= 0 means show it as soon as possible (a redraw, or a frame that is already late)
+    double duration_ns;  // the frame's nominal display duration; < 0 when unknown
+} mpv_cvpixel_timing;
