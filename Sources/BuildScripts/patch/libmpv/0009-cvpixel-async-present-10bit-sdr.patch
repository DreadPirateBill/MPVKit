+
+// The present thread: for each queued frame, in order, wait for its render to
+// complete on the GPU, then present it (or release it, if flushed meanwhile)
+// and free its texture wrapper. Runs until told to quit AND the queue is empty,
+// so every frame in flight at teardown is waited for and released.
+static MP_THREAD_VOID present_thread(void *arg)
+{
+    struct ra_ctx *ctx = arg;
+    struct priv *p = ctx->priv;
+    mp_thread_set_name("cvpixel/present");
+
+    while (1) {
+        mp_mutex_lock(&p->lock);
+        while (!p->queue_len && !p->quit)
+            mp_cond_wait(&p->cond, &p->lock);
+        if (!p->queue_len) {
+            mp_mutex_unlock(&p->lock);
+            break;
+        }
+        struct pending f = p->queue[p->queue_head];
+        mp_mutex_unlock(&p->lock);
+
+        VkSemaphoreWaitInfo wait = {
+            .sType = VK_STRUCTURE_TYPE_SEMAPHORE_WAIT_INFO,
+            .semaphoreCount = 1,
+            .pSemaphores = &p->done_sem,
+            .pValues = &f.serial,
+        };
+        VkResult res = p->wait_semaphores(p->vk.vulkan->device, &wait, RENDER_TIMEOUT_NS);
+
+        mp_mutex_lock(&p->lock);
+        bool discard = p->queue[p->queue_head].discard;   // a flush may have marked it during the wait
+        p->queue_head = (p->queue_head + 1) % MAX_PENDING;
+        p->queue_len--;
+        mp_cond_broadcast(&p->cond);   // a submit may be waiting for the slot
+        mp_mutex_unlock(&p->lock);
+
+        if (res != VK_SUCCESS) {
+            MP_WARN(ctx, "Render of frame %llu not complete after %d ms (%d); dropping it\n",
+                    (unsigned long long)f.serial, (int)(RENDER_TIMEOUT_NS / 1000000), (int)res);
+            discard = true;
+        }
+        if (discard) {
+            CVPixelBufferRelease(f.pbuf);
+        } else {
+            present_now(p, f.pbuf, &f.color, f.due_at_ns, f.duration_ns);
+        }
+        pl_tex_destroy(p->vk.gpu, &f.tex);
+        CFRelease(f.mtltex);
+        CVMetalTextureCacheFlush(p->cache, 0);
+    }
+    MP_THREAD_RETURN();
+}
