+    mp_mutex_lock(&p->lock);
+    p->quit = true;
+    mp_cond_broadcast(&p->cond);
+    mp_mutex_unlock(&p->lock);
+    mp_thread_join(p->present_thread);
+    p->thread_started = false;
+}
