+// Set up the completion signal and the present thread; on any failure the
+// context keeps the synchronous hand-over.
+static void init_async(struct ra_ctx *ctx)
+{
+    struct priv *p = ctx->priv;
+    pl_gpu gpu = p->vk.gpu;
+    pl_vulkan vulkan = p->vk.vulkan;
+
+    if (!gpu->limits.thread_safe) {
+        MP_WARN(ctx, "pl_gpu is not thread-safe; presenting synchronously\n");
+        return;
+    }
+    p->wait_semaphores = (PFN_vkWaitSemaphores)
+        vulkan->get_proc_addr(vulkan->instance, "vkWaitSemaphores");
+    if (!p->wait_semaphores) {
+        p->wait_semaphores = (PFN_vkWaitSemaphores)
+            vulkan->get_proc_addr(vulkan->instance, "vkWaitSemaphoresKHR");
+    }
+    if (!p->wait_semaphores) {
+        MP_WARN(ctx, "vkWaitSemaphores unavailable; presenting synchronously\n");
+        return;
+    }
+    p->done_sem = pl_vulkan_sem_create(gpu, pl_vulkan_sem_params(
+        .type = VK_SEMAPHORE_TYPE_TIMELINE,
+        .initial_value = 0,
+    ));
+    if (!p->done_sem) {
+        MP_WARN(ctx, "No timeline semaphore; presenting synchronously\n");
+        return;
+    }
+    mp_mutex_init(&p->lock);
+    mp_cond_init(&p->cond);
+    p->async = true;
+    if (mp_thread_create(&p->present_thread, present_thread, ctx)) {
+        MP_WARN(ctx, "Could not start the present thread; presenting synchronously\n");
+        mp_cond_destroy(&p->cond);
+        mp_mutex_destroy(&p->lock);
+        p->async = false;
+        pl_vulkan_sem_destroy(gpu, &p->done_sem);
+        return;
+    }
+    p->thread_started = true;
+    MP_VERBOSE(ctx, "Presenting from the render's completion\n");
+}
